---
import PageLayout from '../layouts/PageLayout.astro';
import Schedule from '../components/Schedule.astro';
import { withBase } from '../utils/slugify';
---

<PageLayout title="Agenda" description="La agenda completa de Detrás del humo.">
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<p class="eyebrow m-0">Agenda</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">Programa del hackatón</h1>
			<p class="text-base text-muted m-0">Consulta las actividades, mentorías y presentaciones de los dos días.</p>
		</header>
		<Schedule />
	</section>
</PageLayout>