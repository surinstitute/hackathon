---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Schedule from '../../components/Schedule.astro';
import { defaultLang, languages, showDefaultLang } from '../../i18n/ui';

export async function getStaticPaths() {
	const conferences = await getCollection('conferences');
	return [...new Set(conferences.map((conference) => conference.id.split('/')[0]))]
		.filter((lang): lang is keyof typeof languages => lang in languages)
		.filter((lang) => showDefaultLang || lang !== defaultLang)
		.map((lang) => ({ params: { lang } }));
}
---

<PageLayout title="Schedule" description="The full agenda for Hackathon events.">
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<p class="eyebrow m-0">Schedule</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">Make the most of the day</h1>
			<p class="text-base text-muted m-0">A clear view of every session, conversation, and moment in between.</p>
		</header>
		<Schedule />
	</section>
</PageLayout>