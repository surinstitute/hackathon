---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { defaultLang, languages, showDefaultLang } from '../../../i18n/ui';
import NewsPost from '../../../layouts/NewsPost.astro';

export async function getStaticPaths() {
	const entries = await getCollection('news');
	return entries
		.filter((entry) => {
			const [lang] = entry.id.split('/');
			return lang in languages && (showDefaultLang || lang !== defaultLang);
		})
		.map((entry) => {
			const [lang, ...slug] = entry.id.split('/');
			return { params: { lang, slug: slug.join('/') }, props: entry };
		});
}

const entry = Astro.props as CollectionEntry<'news'>;
const { Content } = await render(entry);
---

<NewsPost {...entry.data}><Content /></NewsPost>