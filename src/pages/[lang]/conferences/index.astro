---
import { getCollection } from 'astro:content';
import ConferenceList from '../../../components/ConferenceList.astro';
import { defaultLang, languages, showDefaultLang } from '../../../i18n/ui';
import PageLayout from '../../../layouts/PageLayout.astro';

export async function getStaticPaths() {
	const conferences = await getCollection('conferences');
	return [...new Set(conferences.map((conference) => conference.id.split('/')[0]))]
		.filter((lang): lang is keyof typeof languages => lang in languages)
		.filter((lang) => showDefaultLang || lang !== defaultLang)
		.map((lang) => ({ params: { lang } }));
}
---

<PageLayout title="Conferences" description="The full Hackathon conference program.">
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<p class="eyebrow m-0">Hackathon 2026</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">Programa</h1>
			<p class="text-base text-muted m-0">Every conference, in the order it happens.</p>
		</header>
		<ConferenceList />
	</section>
</PageLayout>