---
import PageLayout from '../layouts/PageLayout.astro';
import Speakers from '../components/Speakers.astro';
---

<PageLayout title="Personas invitadas" description="Conoce a las personas que acompañarán el hackatón.">
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<p class="eyebrow m-0">Personas invitadas</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">Voces para acompañar el proceso</h1>
			<p class="text-base text-muted m-0">Conoce a las personas que compartirán su experiencia durante el hackatón.</p>
		</header>
		<Speakers />
	</section>
</PageLayout>