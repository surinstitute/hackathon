---
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { defaultLang } from '../i18n/ui';

const authorsEntries = (await getCollection('authors')).filter((entry) => entry.id.startsWith(`${defaultLang}/`));
const team = authorsEntries.map((entry) => entry.data);
---

<PageLayout
	title="About the studio"
	description="The people bringing Hackathon's climate conversations to Mexico City."
	eyebrow="Hackathon team"
>
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<p class="text-xs uppercase tracking-[0.3em] text-subtle">Organizers</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink">Meet the people behind Hackathon</h1>
			<p class="text-base text-muted">
				A small team bringing science, community knowledge, and practical climate action together.
			</p>
		</header>

		<div class="grid gap-6 md:grid-cols-3">
			{team.map((person) => (
				<Card
					title={person.name}
					eyebrow={person.role}
					description={person.bio}
					image={person.avatar}
					imageAlt={person.name}
				>
					<div class="mt-3 space-y-1 text-sm text-subtle">
						{person.location && <p class="m-0 font-medium text-muted">{person.location}</p>}
						{person.focus && <p class="m-0">{person.focus}</p>}
					</div>
				</Card>
			))}
		</div>
	</section>
</PageLayout>
