---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import NewsPost from '../../layouts/NewsPost.astro';

export async function getStaticPaths() {
	const entries = (await getCollection('news')).filter((entry) => entry.id.startsWith('es/'));
	return entries.map((entry) => ({ params: { slug: entry.id.replace(/^es\//, '') }, props: entry }));
}

const entry = Astro.props as CollectionEntry<'news'>;
const { Content } = await render(entry);
---

<NewsPost {...entry.data}><Content /></NewsPost>