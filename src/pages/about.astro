---
import { getCollection } from 'astro:content';
import About from '../components/About.astro';
import Card from '../components/Card.astro';
import PageLayout from '../layouts/PageLayout.astro';
import Sponsors from '../components/Sponsors.astro';

const organizers = (await getCollection('authors'))
	.filter((entry) => entry.id.startsWith('es/'))
	.map((entry) => entry.data);
const showOrganizers = false;
---

<PageLayout title="El hackatón" description="Detrás del humo: hackatón de incidencia en salud frente a los nuevos productos de nicotina.">
	<section class="content-shell py-12 space-y-14">
		<About lang="es" />

		<section class="grid gap-8 border-b border-border pb-14 md:grid-cols-[minmax(0,1.25fr)_minmax(16rem,0.75fr)]" aria-labelledby="about-heading">
			<div class="space-y-5">
				<p class="eyebrow m-0">El encuentro</p>
				<h1 id="about-heading" class="m-0 text-3xl font-semibold leading-tight text-ink sm:text-4xl">Ideas jóvenes para proteger la salud colectiva.</h1>
				<p class="m-0 text-lg leading-relaxed text-muted">Detrás del humo reúne a estudiantes de distintas disciplinas para crear campañas de incidencia frente a los vapeadores, las bolsas de nicotina y el tabaco calentado.</p>
				<p class="m-0 leading-relaxed text-muted">Las políticas públicas y la prevención no siempre avanzan al ritmo de estos productos y su comercialización. El hackatón abre un espacio para que las juventudes imaginen respuestas informadas, éticas y viables.</p>
				<p class="m-0 leading-relaxed text-muted">Cada equipo desarrollará una propuesta clara de incidencia que ayude a prevenir daños, fortalecer entornos saludables y proteger derechos.</p>
			</div>
			<div class="space-y-5 border-l-0 border-border pt-1 lg:border-l lg:pl-8">
				<p class="m-0 text-lg font-semibold leading-snug text-ink">Creación, colaboración y acción.</p>
				<p class="m-0 leading-relaxed text-muted">Durante dos días, los equipos recibirán inspiración, integrarán perspectivas diversas, prototiparán campañas y contarán con mentorías especializadas.</p>
				<p class="m-0 leading-relaxed text-muted">La experiencia culmina con la presentación de propuestas ante un jurado multidisciplinario y retroalimentación para hacerlas más robustas.</p>
			</div>
		</section>

		{showOrganizers && (
			<section class="space-y-6" aria-labelledby="organizers-heading">
				<header class="max-w-2xl space-y-2">
					<p class="eyebrow m-0">Organización</p>
					<h1 id="organizers-heading" class="m-0 text-3xl font-semibold leading-tight text-ink sm:text-4xl">Las personas detrás del hackatón</h1>
					<p class="m-0 text-muted">SUR Institute organiza el encuentro en colaboración con CREA y con apoyo de Campaign for Tobacco-Free Kids y Bloomberg Philanthropies.</p>
				</header>
				<div class="grid gap-6 md:grid-cols-3">
					{organizers.map((organizer) => <Card title={organizer.name} eyebrow={organizer.role} description={organizer.bio} image={organizer.avatar} imageAlt={organizer.name} />)}
				</div>
			</section>
		)}

		<section class="border-y border-border py-10" aria-labelledby="sponsors-heading">
			<div class="max-w-2xl space-y-3">
				<p class="eyebrow m-0">Organizaciones Aliadas</p>
				<h2 id="sponsors-heading" class="m-0 text-2xl font-semibold leading-tight text-ink">Hacer posible Detrás del humo</h2>
				<p class="m-0 text-muted">Las alianzas fortalecen un espacio independiente de la industria tabacalera, guiado por evidencia científica, protección de derechos y bienestar colectivo.</p>
			</div>
			<div class="mt-8">
				<Sponsors />
			</div>
		</section>
	</section>
</PageLayout>
