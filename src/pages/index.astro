---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ConferenceList from '../components/ConferenceList.astro';
import Numbers from '../components/Numbers.astro';
import About from '../components/About.astro';
import Sponsors from '../components/Sponsors.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../utils/consts';
const site = await getSite();
const conferences = (await getCollection('conferences')).filter((conference) => conference.id.startsWith('es/'));
const speakerCount = (await getCollection('speakers')).filter((speaker) => speaker.id.startsWith('es/')).length;
const dayCount = new Set(conferences.map((conference) => conference.data.day)).size;
---

<PageLayout
	title={site.title}
>
	<Hero
			eyebrow="22 y 23 de octubre de 2026 · Ciudad de México"
			title="Detrás del humo"
			description="Hackatón de incidencia en salud frente a los nuevos productos de nicotina."
		actions={[
			{ label: 'Conoce el reto', href: '/about' },
			{ label: 'Consulta la agenda', href: '/schedule' },
		]}
	/>

	<Sponsors />

	<About lang="es" />

	<Numbers
			eyebrow="El hackatón en cifras"
			title="Dos días para convertir ideas en incidencia"
			copy="Un espacio de creatividad, colaboración y acción para proteger la salud colectiva."
		stats={[
			{ label: 'Momentos', value: String(conferences.length), description: 'Inspiración, ideación, mentorías y presentación final.' },
			{ label: 'Personas invitadas', value: String(speakerCount), description: 'Especialistas que acompañarán el proceso.' },
			{ label: 'Días', value: String(dayCount), description: 'Tiempo compartido para aprender, crear y proponer.' },
		]}
	/>

	<ConferenceList
		heading="Programa del hackatón"
		limit={3}
		viewAllHref="/conferences"
	/>

</PageLayout>
