---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ConferenceList from '../components/ConferenceList.astro';
import Numbers from '../components/Numbers.astro';
import About from '../components/About.astro';
import Sponsors from '../components/Sponsors.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../utils/consts';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const site = await getSite();
const lang = getLangFromUrl(Astro.url);
const conferences = (await getCollection('conferences')).filter((conference) => conference.id.startsWith('es/'));
const dayCount = new Set(conferences.map((conference) => conference.data.day)).size;
const mentorshipCount = conferences.length;
const t = useTranslations(lang);
---

<PageLayout
	title={site.title}
>
	<Hero
			eyebrow="22 y 23 de octubre de 2026 · Ciudad de México - Conferencia Interamericana de Seguridad Social"
			title="Hackatón Detrás del humo sí se ve"
			highlightedWord="Hackatón"
			description="Evento gratuito de incidencia en salud frente a los nuevos productos de nicotina. | Participación gratuita · Cupos limitados"
		actions={[
		    { label: t('nav.register'), href: '/inscripcion' },
			{ label: '¿De que trata?', href: '/about' },
		]}
	/>

	<Sponsors />

	<About lang="es" />

	<Numbers
			eyebrow="Lo que vas a vivir"
			title="Una experiencia para crear algo que importe"
			copy="Trabaja con personas de distintas disciplinas, recibe acompañamiento y convierte una idea en una propuesta de incidencia."
		stats={[
		    { label: 'Equipos', value: '10', description: 'Cada equipo contará con 5 participantes de distintas disciplinas.' },
			{ label: 'Retos de incidencia', value: '4', description: 'Regulación, impuestos, impacto ambiental y prevención.' },
			{ label: 'Mentores especializados', value: String(mentorshipCount), description: 'Acompañamiento especializado para fortalecer tu propuesta.' },
			{ label: 'Jornadas de trabajo', value: String(dayCount), description: 'Dos días para idear, prototipar y presentar.' },
		]}
	/>

	<ConferenceList
		heading="Programa del hackatón"
		limit={3}
		viewAllHref="/conferences"
	/>

</PageLayout>
