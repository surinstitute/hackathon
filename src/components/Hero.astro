---
import { Image } from 'astro:assets';
import heroImage from '../assets/wallpaper.png';
import HeyFormTrigger from './HeyFormTrigger.astro';
import Plasma from './Plasma.vue';

interface Action {
	label: string;
	href: string;
	modal?: boolean;
}

interface Props {
	eyebrow?: string;
	title: string;
	highlightedWord?: string;
	description?: string;
	actions?: Action[];
}

import { withBase } from '../utils/slugify';

const { eyebrow, title, highlightedWord, description, actions = [] } = Astro.props;
const titleParts = highlightedWord ? title.split(highlightedWord) : [title];
---


<section class="hero">
	<Image class="hero-image" src={heroImage} alt="" width={1440} height={960} loading="eager" />
	<div class="hero-overlay" aria-hidden="true"></div>
	<div class="content-shell hero-content">
		<div class="grid max-w-3xl gap-4">
			<h1>
				{titleParts.map((part, index) => (
					<>
						{part}
						{index < titleParts.length - 1 && <span class="hero-highlight">{highlightedWord}</span>}
					</>
				))}
			</h1>
			{eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
			{description && <p class="hero-description">{description}</p>}
			{actions.length > 0 && (
				<div class="flex flex-wrap gap-3 pt-3">
					{actions.map((action, index) => (
						action.modal ? (
							<HeyFormTrigger
								label={action.label}
								size="hero"
								class:list={['hero-action', { 'hero-action-secondary': index > 0 }]}
							/>
						) : (
							<a class:list={['hero-action', { 'hero-action-secondary': index > 0 }]} href={withBase(action.href)}>
								{action.label}
							</a>
						)
					))}
				</div>
			)}
		</div>
	</div>
	<div class="hero-plasma" aria-hidden="true">
		<Plasma client:visible colorToken="--accent-color" speed={0.6} scale={0.5} opacity={0.7} mouseInteractive={true} />
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: end;
		isolation: isolate;
		width: 100vw;
		max-width: none;
		margin-left: calc(50% - 50vw);
		min-height: calc(50vh - var(--grid-cell));
		overflow: hidden;
		border-bottom: 4px solid var(--color-ink);
		background: var(--color-surface);
	}

	.hero-image,
	.hero-plasma,
	.hero-overlay {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-image {
		z-index: -3;
		object-fit: cover;
		object-position: center center;
	}

	.hero-plasma {
		z-index: 1;
		pointer-events: none;
	}

	.hero-overlay {
		z-index: -2;
		background:
			linear-gradient(90deg, var(--hero-overlay-start) 0%, var(--hero-overlay-middle) 58%, var(--hero-overlay-end) 100%);
	}

	:global(:root) {
		--hero-overlay-start: color-mix(in oklab, var(--color-surface) 65%, transparent);
		--hero-overlay-middle: color-mix(in oklab, var(--color-surface) 45%, transparent);
		--hero-overlay-end: color-mix(in oklab, var(--color-surface) 25%, transparent);
		--hero-content-color: var(--color-ink);
		--hero-muted-color: color-mix(in oklab, var(--color-ink) 90%, transparent);
		--hero-button-background: var(--accent-color);
		--hero-button-color: #050505;
		--hero-button-border: #050505;
		--hero-button-secondary-background: rgb(255 255 255 / 78%);
		--hero-button-secondary-color: #050505;
		--hero-button-secondary-border: #050505;
	}

	.hero-content {
		padding-top: clamp(5rem, 13vh, 10rem);
		padding-bottom: clamp(3rem, 10vh, 7rem);
		color: var(--hero-content-color);
	}

	.hero-eyebrow {
		margin: 0;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--accent-color);
	}

	.hero-content h1 {
		margin: 0;
		font-size: clamp(2.75rem, 7vw, 6rem);
		font-weight: 600;
		line-height: 1.04;
	}

	.hero-highlight {
		display: inline-block;
		padding: 0.02em 0.13em 0.08em;
		border: 0.07em solid var(--color-ink);
		border-radius: 0.16em;
		background: var(--primary-color);
		box-shadow: 0.09em 0.09em 0 var(--color-ink);
		color: var(--color-ink);
		transform: translate(-0.02em, -0.02em) rotate(-1deg);
	}

	.hero-description {
		max-width: 42rem;
		margin: 0;
		font-size: clamp(1rem, 1.5vw, 1.2rem);
		line-height: 1.6;
		color: var(--hero-muted-color);
	}

	.hero-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0.65rem 1.1rem;
		border: 1px solid var(--hero-button-border);
		border: 2px solid var(--hero-button-border);
		border-radius: 0.65rem;
		background: var(--hero-button-background);
		color: var(--hero-button-color);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		box-shadow: 5px 5px 0 var(--color-ink);
		transition: background-color 150ms ease, color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
	}

	.hero-action:hover {
		transform: translate(5px, 5px);
		background: #fff;
		box-shadow: none;
		color: #050505;
	}

	.hero-action-secondary {
		border-color: var(--hero-button-secondary-border);
		background: var(--hero-button-secondary-background);
		color: var(--hero-button-secondary-color);
	}

	.hero-action-secondary:hover {
		background: #fff;
		color: #050505;
	}

	@media (max-width: 720px) {
		.hero {
			min-height: calc(80vh - calc(var(--grid-cell) * 4));
		}

		.hero-image {
			object-position: 62% center;
		}

	}
</style>
