---
import { getSite } from '../utils/consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { withBase } from '../utils/slugify';
import logo from '../assets/logos/sur.png';

const site = await getSite();
import { Icon } from 'astro-icon/components'
import Clock from './Clock.astro';

const today = new Date();
const socials = (await getCollection('socials')).map((entry) => entry.data);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const registrationUrl = site.registrationUrl ?? withBase(translatePath('/about/'));
const iconMap: Record<string, string> = {
  x: 'tabler:brand-x',
  twitter: 'tabler:brand-x',
  github: 'tabler:brand-github',
  linkedin: 'tabler:brand-linkedin',
  email: 'tabler:mail',
  mastodon: 'tabler:brand-mastodon',
};
---

<footer class="border-t border-border bg-surface py-8">
  <div class="content-shell">
    <div class="grid gap-10 border-b border-border pb-10 md:grid-cols-2">
      <div class="space-y-6">
        <p class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink">{t('footer.navigation')}</p>
        <div class="grid gap-2 sm:grid-cols-2 text-sm text-ink">
          <a class="font-semibold transition-colors hover:text-ink" href={withBase(translatePath('/'))}>{t('nav.home')}</a>
          <a class="font-semibold transition-colors hover:text-ink" href={withBase(translatePath('/about/'))}>{t('nav.about')}</a>
          <a class="font-semibold transition-colors hover:text-ink" href={withBase(translatePath('/conferences/'))}>{t('nav.conferences')}</a>
          <a class="font-semibold transition-colors hover:text-ink" href={withBase(translatePath('/schedule/'))}>{t('nav.schedule')}</a>
          <a class="font-semibold transition-colors hover:text-ink" href={withBase(translatePath('/speakers/'))}>{t('nav.speakers')}</a>
          <a class="font-semibold transition-colors hover:text-ink" href={withBase(translatePath('/venue/'))}>{t('nav.venue')}</a>
          <a class="font-semibold transition-colors hover:text-ink" href={withBase(translatePath('/news/'))}>{t('nav.news')}</a>
          <a class="font-semibold text-[#ff7226] transition-colors hover:text-ink" href={registrationUrl} target="_blank" rel="noopener noreferrer">{t('nav.register')}</a>
        </div>
      </div>
      <div class="grid gap-8">
        <div class="grid gap-3">
          <p class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink">{t('footer.connect')}</p>
          <div class="grid gap-2 sm:grid-cols-2 text-sm text-ink">
            {socials.map((social) => {
              const iconName = social.id ? iconMap[social.id.toLowerCase()] : undefined;
              const fallback = social.label?.trim()?.[0]?.toUpperCase() ?? '?';
              return (
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel={social.href.startsWith('http') ? 'noreferrer' : undefined}
                  class="flex items-center gap-2 rounded-md px-2 py-1 transition-colors hover:text-ink hover:bg-[color-mix(in_oklab,var(--color-ink)_3%,transparent)]"
                >
                  {iconName ? (
                    <Icon
                      name={iconName}
                      size={18}
                      stroke-width={1.5}
                      class="text-ink"
                      aria-hidden={true}
                    />
                  ) : (
                    <span class="inline-flex h-6.5 w-6.5 items-center justify-center rounded-full border border-border text-[0.7rem] font-semibold text-ink" aria-hidden="true">{fallback}</span>
                  )}
                  <span class="leading-tight">{social.label}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
    <div class="grid gap-6 pt-8 pb-4 md:flex md:items-center md:justify-between">
        <a href={withBase(translatePath('/'))} aria-label={site.title} class="mb-10 inline-block">
          <Image src={logo} alt={site.title} width={300} height={94} loading="eager" class="h-auto w-56 sm:w-72" />
        </a>
      <p class="text-sm text-ink m-0"> {site.title} &copy; <a href="https://github.com/roicort/launchpad" class="underline text-muted hover:text-ink">Astro Launchpad</a> {today.getFullYear()}. {t('footer.allRightsReserved')} </p>
      <div class="md:text-right space-y-2 md:space-y-1">
        <div class="flex flex-wrap items-center gap-3 md:justify-end">
          <p class="text-2xl sm:text-3xl font-semibold tracking-tight text-ink m-0">{site.based}</p>
          <Clock
            timeZone={site.timezone ? site.timezone : "UTC"}
            locale={site.locale ? site.locale : "en-US"}
            hour12={false}
            showSeconds={false}
          />
        </div>
        <p class="text-sm text-muted m-0"> {t('footer.designedBy')} <a href="https://roicort.github.io" target="_blank" rel="noreferrer" class="underline text-muted hover:text-ink">Rodrigo Cortez</a> {t('footer.inCity')}</p>
      </div>
    </div>
  </div>
</footer>
